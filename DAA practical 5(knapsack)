w = [2, 3, 4, 5]
p = [1, 2, 5, 6]
m = 8
n = len(w)

dp = [[0] * (m + 1) for _ in range(n + 1)]

for i in range(1, n + 1):
    for j in range(m + 1):
        if w[i - 1] <= j:
            dp[i][j] = max(dp[i - 1][j], p[i - 1] + dp[i - 1][j - w[i - 1]])
        else:
            dp[i][j] = dp[i - 1][j]

print("Maximum Profit:", dp[n][m])

print("DP Table:")
for row in dp:
    print(row)
    
